{
  "openapi": "3.1.0",
  "info": {
    "title": "WhyQuiet API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "post": {
        "summary": "Profile",
        "operationId": "profile_api_profile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/triage": {
      "post": {
        "summary": "Triage",
        "operationId": "triage_api_triage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/explain": {
      "post": {
        "summary": "Explain",
        "operationId": "explain_api_explain_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplainRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/refuse": {
      "post": {
        "summary": "Refuse",
        "operationId": "refuse_api_refuse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefuseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefuseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CauseFamily": {
        "type": "string",
        "enum": [
          "job_exit",
          "migration",
          "solved_problem",
          "fee_shock",
          "supply_failure"
        ],
        "title": "CauseFamily"
      },
      "ExplainRequest": {
        "properties": {
          "wallet_id": {
            "type": "string",
            "title": "Wallet Id"
          }
        },
        "type": "object",
        "required": [
          "wallet_id"
        ],
        "title": "ExplainRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "store": {
            "$ref": "#/components/schemas/StoreKind"
          },
          "stub": {
            "type": "boolean",
            "title": "Stub",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "store"
        ],
        "title": "HealthResponse"
      },
      "ProfileRequest": {
        "properties": {
          "wallet_id": {
            "type": "string",
            "title": "Wallet Id"
          }
        },
        "type": "object",
        "required": [
          "wallet_id"
        ],
        "title": "ProfileRequest"
      },
      "Reason": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution"
          },
          "direction": {
            "type": "string",
            "title": "Direction",
            "description": "'toward' or 'against' the attributed cause"
          }
        },
        "type": "object",
        "required": [
          "feature",
          "contribution",
          "direction"
        ],
        "title": "Reason"
      },
      "RefuseRequest": {
        "properties": {
          "wallet_id": {
            "type": "string",
            "title": "Wallet Id"
          }
        },
        "type": "object",
        "required": [
          "wallet_id"
        ],
        "title": "RefuseRequest"
      },
      "RefuseResponse": {
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "cause": {
            "type": "null",
            "title": "Cause"
          },
          "posterior": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Posterior"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "type": "array",
            "title": "Reasons"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assumptions"
          },
          "generated_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated Text"
          },
          "refusal_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Refusal Reasons"
          },
          "stub": {
            "type": "boolean",
            "title": "Stub",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "posterior",
          "reasons",
          "assumptions",
          "generated_text",
          "refusal_reasons"
        ],
        "title": "RefuseResponse"
      },
      "StoreKind": {
        "type": "string",
        "enum": [
          "local",
          "supabase"
        ],
        "title": "StoreKind"
      },
      "TriageRequest": {
        "properties": {
          "wallet_id": {
            "type": "string",
            "title": "Wallet Id"
          }
        },
        "type": "object",
        "required": [
          "wallet_id"
        ],
        "title": "TriageRequest"
      },
      "TriageResponse": {
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "cause": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CauseFamily"
              },
              {
                "type": "null"
              }
            ]
          },
          "posterior": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Posterior"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "type": "array",
            "title": "Reasons"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assumptions"
          },
          "generated_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated Text"
          },
          "stub": {
            "type": "boolean",
            "title": "Stub",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "cause",
          "posterior",
          "reasons",
          "assumptions",
          "generated_text"
        ],
        "title": "TriageResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verdict": {
        "type": "string",
        "enum": [
          "attributed",
          "refused"
        ],
        "title": "Verdict"
      }
    }
  }
}