    "/api/wallets/locked": {
      "get": {
        "summary": "List Locked Wallets",
        "operationId": "list_locked_wallets_api_wallets_locked_get",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LockedWallet"
                  },
                  "title": "Response List Locked Wallets Api Wallets Locked Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/batches/{id}/audit": {
      "get": {
        "summary": "Get Batch Audit",
        "operationId": "get_batch_audit_api_batches__id__audit_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntry"
                  },
                  "title": "Response Get Batch Audit Api Batches  Id  Audit Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "actor_role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "target_id": {
            "type": "string",
            "title": "Target Id"
          },
          "metadata": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Metadata"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "actor_id",
          "actor_role",
          "action",
          "target_id",
          "created_at"
        ],
        "title": "AuditEntry"
      },
      "Batch": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "cause": {
            "$ref": "#/components/schemas/CauseFamily"
          },
          "remedy_code": {
            "type": "string",
            "title": "Remedy Code"
          },
          "unit_cost_bdt": {
            "type": "number",
            "title": "Unit Cost Bdt"
          },
          "wallet_count": {
            "type": "integer",
            "title": "Wallet Count"
          },
          "status": {
            "$ref": "#/components/schemas/BatchStatus"
          },
          "proposed_by": {
            "type": "string",
            "title": "Proposed By"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "decided_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decision_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Note"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "cause",
          "remedy_code",
          "unit_cost_bdt",
          "wallet_count",
          "status",
          "proposed_by",
          "created_at"
        ],
        "title": "Batch"
      },
      "BatchStatus": {
        "type": "string",
        "enum": [
          "proposed",
          "approved",
          "rejected"
        ],
        "title": "BatchStatus"
      },
      "CauseFamily": {
        "type": "string",
        "enum": [
          "job_exit",
          "migration",
          "solved_problem",
          "fee_shock",
          "supply_failure"
        ],
        "title": "CauseFamily"
      },
      "CreateBatchRequest": {
        "properties": {
          "cause": {
            "$ref": "#/components/schemas/CauseFamily"
          },
          "wallet_ids": {
            "items": {
              "type": "string",
              "pattern": "^W-[0-9A-Z]{6}$"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Wallet Ids"
          }
        },
        "type": "object",
        "required": [
          "cause",
          "wallet_ids"
        ],
        "title": "CreateBatchRequest"
      },
      "DecisionRequest": {
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "note"
        ],
        "title": "DecisionRequest"
      },
      "ExportBatchResponse": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "cause": {
            "$ref": "#/components/schemas/CauseFamily"
          },
          "remedy_code": {
            "type": "string",
            "title": "Remedy Code"
          },
          "wallet_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Wallet Ids"
          },
          "cost_bdt": {
            "type": "number",
            "title": "Cost Bdt"
          },
          "approved_by": {
            "type": "string",
            "title": "Approved By"
          },
          "approved_at": {
            "type": "string",
            "title": "Approved At"
          }
        },
        "type": "object",
        "required": [
          "batch_id",
          "cause",
          "remedy_code",
          "wallet_ids",
          "cost_bdt",
          "approved_by",
          "approved_at"
        ],
        "title": "ExportBatchResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "store": {
            "$ref": "#/components/schemas/StoreKind"
          },
          "stub": {
            "type": "boolean",
            "title": "Stub",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "store"
        ],
        "title": "HealthResponse"
      },
      "LockReason": {
        "type": "string",
        "enum": [
          "open",
          "cooldown"
        ],
        "title": "LockReason"
      },
      "LockedWallet": {
        "properties": {
          "wallet_id": {
            "type": "string",
            "title": "Wallet Id"
          },
          "reason": {
            "$ref": "#/components/schemas/LockReason"
          },
          "until": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Until"
          }
        },
        "type": "object",
        "required": [
          "wallet_id",
          "reason"
        ],
        "title": "LockedWallet"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user_id",
          "role"
        ],
        "title": "LoginResponse"
      },
      "StoreKind": {
        "type": "string",
        "enum": [
          "local",
          "supabase"
        ],
        "title": "StoreKind"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "analyst",
          "approver"
        ],
        "title": "UserRole"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}