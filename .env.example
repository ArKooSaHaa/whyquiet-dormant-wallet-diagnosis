# Copy to .env (gitignored, never commit). Loaded by `uv run --env-file .env ...` / `make dev`.
# Leave values empty to run the read-only console: without the Supabase pair the API still
# starts, /api/health reports store "local", and the write path (login, batches) returns 503.

# --- Write path (API server, server-side only) -------------------------------------------
# Supabase dashboard > Project Settings > API > Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase dashboard > Project Settings > API > service_role secret. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo accounts (local only, read by supabase/seed_demo_users.py) --------------------
# Choose any strong passwords; the script sets them on analyst@ / approver@whyquiet.demo.
DEMO_ANALYST_PASSWORD=
DEMO_APPROVER_PASSWORD=

# --- Optional local tooling (not read by application code) ------------------------------
# Supabase dashboard > Project Settings > API > anon public key
SUPABASE_ANON_KEY=
# Database password chosen when creating the Supabase project (Supabase CLI `db push`)
SUPABASE_DB_PASSWORD=

# --- Optional overrides -------------------------------------------------------------------
# Port the Vite dev server proxies /api to (default 8008). Read from the shell running `npm run dev`.
API_PORT=
